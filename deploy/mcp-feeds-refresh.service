[Unit]
Description=Crawl RSS/Atom feeds into the mcp-feeds cache
Documentation=https://github.com/crunchtools/mcp-feed-reader
After=mcp-feeds.crunchtools.com.service
Requisite=mcp-feeds.crunchtools.com.service

[Service]
Type=oneshot
# Runs inside the live container, so the DB keeps the running server SELinux
# category. Never bind-mount /srv/mcp-feeds.crunchtools.com/data elsewhere
# with :Z -- that relabels it and locks the server out.
ExecStart=/usr/bin/podman exec mcp-feeds python -m mcp_feed_reader_crunchtools --fetch
# Worst case is every feed timing out on all three attempts with backoff in
# between: dozens of feeds is far more than this allows, but a crawl that long
# is already a failure worth killing.
TimeoutStartSec=900
